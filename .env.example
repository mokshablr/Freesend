# -----------------------------------------------------------------------------
# App - Don't add "/" in the end of the url (same in production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# Generate AUTH_SECRET with: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Not needed when running via docker-compose - it is computed from
# POSTGRES_PASSWORD and the internal `db` service hostname.
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Encryption (AES-256-CBC for stored SMTP passwords)
# WARNING: Never rotate these after first use - all stored SMTP passwords
# become unrecoverable. Back them up alongside your database.
#
# Generate KEY: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Generate IV:  node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=
ENCRYPTION_IV=

# -----------------------------------------------------------------------------
# Docker (only used by docker-compose)
# Generate a strong password: openssl rand -base64 24
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=
