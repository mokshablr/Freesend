# -----------------------------------------------------------------------------
# App - Don't add "/" in the end of the url (same in production)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# Generate AUTH_SECRET with: openssl rand -base64 32
# -----------------------------------------------------------------------------
AUTH_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# Not needed when running via docker-compose - it is computed from
# POSTGRES_PASSWORD and the internal `db` service hostname.
# -----------------------------------------------------------------------------
DATABASE_URL=

# -----------------------------------------------------------------------------
# Encryption (SMTP passwords)
# WARNING: Never rotate ENCRYPTION_KEY after first use - all stored SMTP
# passwords become unrecoverable. Back it up alongside your database.
# -----------------------------------------------------------------------------
# AES-256 key, base64-encoded 32 bytes. Required: saving a mail server or
# sending an email fails without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Deprecated and ignored. Older releases used this as a fixed initialisation
# vector for every SMTP password. Encryption now generates a random IV per
# value and stores it alongside the ciphertext, so passwords written by those
# releases still decrypt and no migration is required. Existing deployments can
# leave this set or remove it.
# ENCRYPTION_IV=

# -----------------------------------------------------------------------------
# Rate limiting (public send endpoints)
# -----------------------------------------------------------------------------
# Requests allowed per window, per API key, per process. Set to 0 to disable.
# Applies to both POST /api/send-email and POST /api/emails, which share one
# counter. Left commented out on purpose: a bare "RATE_LIMIT_MAX=" would be
# read as an empty value, and the default below is almost always what you want.
# RATE_LIMIT_MAX=100

# Window length in milliseconds.
# RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# Docker (only used by docker-compose)
# Generate a strong password: openssl rand -base64 24
# -----------------------------------------------------------------------------
POSTGRES_PASSWORD=
