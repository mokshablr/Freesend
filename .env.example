# -----------------------------------------------------------------------------
# App - Don't add "/" in the end of the url. Ignored by docker-compose.prod.yml
# -----------------------------------------------------------------------------
APP_URL=http://localhost:5000
# Set to false to skip the landing page and send / straight to /login
LANDING_PAGE=true

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
AUTH_SECRET=

# Optional - leave empty to disable Google login (use scripts/set-password.mjs for local accounts)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

POSTGRES_PASSWORD=
# -----------------------------------------------------------------------------
# SMTP credential encryption (base64: openssl rand -base64 32 / -base64 16)
# -----------------------------------------------------------------------------
ENCRYPTION_KEY=
ENCRYPTION_IV=

# -----------------------------------------------------------------------------
# Production proxy (docker-compose.prod.yml only)
# -----------------------------------------------------------------------------
# App at https://DOMAIN, public email API at https://api.DOMAIN
DOMAIN=
ACME_EMAIL=
# Basic auth in front of the web UI  - used for better security.
# Hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'secret'
# Escape every $ in the hash as $$ when pasting it here.
BASIC_AUTH_USER=
BASIC_AUTH_HASH=
