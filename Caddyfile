{
    email {$ACME_EMAIL}
}

# Web UI, auth, dashboard - extra basic-auth layer in front of the app (because it is a javascript hell).
{$DOMAIN} {
    basic_auth {
        {$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
    }
    reverse_proxy app:5000
}

# Public email API only. Bearer API key is checked by the app.
api.{$DOMAIN} {
    @short path /send-email /emails
    handle @short {
        rewrite * /api{uri}
        reverse_proxy app:5000
    }
    @full path /api/send-email /api/emails
    handle @full {
        reverse_proxy app:5000
    }
    handle {
        respond 404
    }
}
